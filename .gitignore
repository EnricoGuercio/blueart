# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# backup grezzo di immagini del sito live del cliente, non referenziato da
# nessuna pagina — include foto sostituite per diritti/brand di terzi (es.
# gallery-img3288.jpg, vedi PROJECT.md), non va pubblicato
/public/images/live/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Pannello di redazione PHP: dati e file del cliente / credenziali, mai nel
# repository (stanno solo sul server; vedi PROJECT.md)
/php-app/data/*
!/php-app/data/.htaccess
!/php-app/data/.gitkeep
/php-app/uploads/*/*
!/php-app/uploads/*/.gitkeep
